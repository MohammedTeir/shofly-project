# Copy to .env (never commit it). Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_USER=shofly
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=shofly

TELEGRAM_BOT_TOKEN=<from @BotFather>
BOT_USERNAME=<bot username without @>
JWT_SIGNING_KEY=<generate, 40+ chars>
BOT_API_TOKEN=<generate; shared by backend and bot only>
WORKER_API_TOKEN=<generate; goes into Colab Secrets only>
ENCRYPTION_KEY=<python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())">  # comma-separate keys to rotate
IMPORT_ALLOWED_HOSTS=<hostnames you are authorized to import from, comma separated>
CORS_ORIGINS=https://<mini-app-host>,https://<admin-host>
PUBLIC_APP_URL=https://<mini-app-host>
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en
BILLING_ENABLED=false
LOG_LEVEL=INFO
BOOTSTRAP_SUPER_ADMIN_TELEGRAM_IDS=<your telegram id; promotes you to super_admin at startup (hosts without a shell)>
