APP_ENV=development
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/tml
TELEGRAM_BOT_TOKEN=<secret>
JWT_SIGNING_KEY=<at-least-32-random-chars>
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en
INITDATA_MAX_AGE_SECONDS=86400
BOT_API_TOKEN=<long-random-secret-shared-with-the-bot-process>
CORS_ORIGINS=https://<mini-app-host>,https://<admin-host>
WORKER_API_TOKEN=<long-random-secret-for-the-colab-worker>
ENCRYPTION_KEY=<python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())">
IMPORT_ALLOWED_HOSTS=<comma-separated hostnames you are authorized to import from>
BOT_USERNAME=<bot username without @>
